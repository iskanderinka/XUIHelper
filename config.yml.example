  # ============================================================
  # XUIHelper — конфигурация
  # ============================================================

  # Токен бота, полученный у @BotFather
  #
  # Токен для ТЕХРАБОТ / разработки
  bot_token: "*********************"

  # Токен для продакшена (закомментируй тестовый выше и раскомментируй этот)
  # bot_token: "*********************"


  # ============================================================
  # Пользователи
  # ============================================================
  users:
    # Список ID администраторов.
    # ПЕРВЫЙ в списке = суперадмин. Остальные = обычные админы.
    # Без суперадмина все админские команды заблокированы.
    admin_users:
      - userID


  # ============================================================
  # Панели 3x-ui
  # ============================================================
  panels:
    "PANEL_NAME":
      # URL панели с префиксом.
      #
      # ВАРИАНТ 1 — бот на ноуте, панель на удалённом сервере (разработка).
      url: ""

      # ВАРИАНТ 2 — бот и панель на одном сервере (продакшен).
      # Закомментируй URL выше, раскомментируй этот.
      # url: ""

      username: "login"
      password: "password"

      # URL подписки — всегда внешний, клиенты ходят снаружи
      sub_url: "https://url:port/sub"


  # ============================================================
  # Часовой пояс
  # ============================================================
  # Используется планировщиком, расчётом «конца дня» и датами подписок.
  # Полный список зон: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
  timezone: ""


  # ============================================================
  # Учёт трафика
  # ============================================================
  traffic:
    # unidirectional — как отдаёт панель
    # bidirectional — умножает на 2
    accounting_mode: unidirectional


  # ============================================================
  # Пользовательский контент
  # ============================================================

  # Политика конфиденциальности
  policy:
    # URL страницы с полным текстом политики (Telegraph, сайт, куда угодно)
    url: ""

    # Краткое сообщение перед кнопкой. Поддерживает Markdown (**жирный**).
    # Если пусто — используется стандартный текст из config.py.
    message: ""


  # Тарифы
  tariffs:
    # URL страницы с тарифами
    url: ""

    # Текст перед кнопкой тарифов.
    # Если пусто — используется стандартный текст.
    message: ""


  # Гайды — три текста с inline-кнопкой на внешнюю статью
  guide:
    # Для клиента → команда /guide
    client:
      url: ""
      message: ""

    # Для админа → команда /guideadmin
    admin:
      url: ""
      message: ""

    # Для суперадмина → команда /guidesuper
    superadmin:
      url: ""
      message: ""